# Copy this to .env and fill in real values. database.js will hard-exit
# (process.exit(1)) on boot if SUPABASE_URL or SUPABASE_KEY are missing —
# on Render this looks like the server crash-looping / never coming up.

# Supabase project settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Use the "service_role" key, NOT the "anon" key. server.js does all reads
# and writes itself (there's no supabase.auth session per request — see the
# dummy x-user-id middleware in server.js), so it needs a key that bypasses
# Row Level Security. If RLS is enabled on any table and you're using the
# anon key instead, every query to that table will fail or return empty.
SUPABASE_KEY=your_supabase_service_role_key

# Origin allowed by CORS + Socket.io. Must match where the frontend is served from.
FRONTEND_URL=http://localhost:5173

PORT=5000
NODE_ENV=development
